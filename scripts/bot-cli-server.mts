// Точка входа отладчика WhatsApp-бота.
//
// Единственная задача этого файла — подключить загрузчик, который подменяет
// модуль отправки (src/lib/greenapi/client.ts) заглушкой, и только ПОСЛЕ
// этого подгрузить ядро. Ядро подключается динамическим import(), иначе его
// статические импорты выполнились бы раньше загрузчика.
import './bot-cli-loader.mjs'

// Через URL, а не литералом: литеральный путь с расширением .mts tsc не
// принимает без allowImportingTsExtensions, а менять общий tsconfig ради
// отладчика не хочется.
await import(new URL('./bot-cli-core.mts', import.meta.url).href)
