# Пример переменных окружения smilekit-crm. Реальные значения — только в .env.local
# (gitignored) и в Railway. Файл дополняется по мере необходимости.

# Телеметрия Control Center («коннектор CRM»): heartbeat, расход LLM, события
# сделок/заказов/ошибок. Оба пустых значения = коннектор выключен (no-op).
CONTROL_CENTER_URL=
CONTROL_CENTER_TOKEN=
